\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Psychophysical function showing the variation of sensitivity ($d'$) with set size. As the number of words in the memory set increases, sensitivity ($d'$) decreases, indicating reduced discriminability.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:dprime_vs_setsize}{{2}{3}{Psychophysical function showing the variation of sensitivity ($d'$) with set size. As the number of words in the memory set increases, sensitivity ($d'$) decreases, indicating reduced discriminability}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Variation of criterion $c$ with set size. Positive values indicate conservative bias, negative values indicate liberal bias. The criterion shifts from conservative to liberal as set size increases, with the dashed line marking neutral bias ($c = 0$).}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:criterion_vs_setsize}{{3}{3}{Variation of criterion $c$ with set size. Positive values indicate conservative bias, negative values indicate liberal bias. The criterion shifts from conservative to liberal as set size increases, with the dashed line marking neutral bias ($c = 0$)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Signal and noise distributions for Set Size 2 (high sensitivity). The large separation between distributions ($d' \approx 2.98$) indicates strong discriminability.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:sig_noise_set2}{{4}{4}{Signal and noise distributions for Set Size 2 (high sensitivity). The large separation between distributions ($d' \approx 2.98$) indicates strong discriminability}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Signal and noise distributions for Set Size 15 (low sensitivity). The substantial overlap between distributions ($d' \approx 0.75$) indicates reduced discriminability.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:sig_noise_set15}{{5}{4}{Signal and noise distributions for Set Size 15 (low sensitivity). The substantial overlap between distributions ($d' \approx 0.75$) indicates reduced discriminability}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Empirical ROC curves for each set size. Each point represents a different confidence threshold. As set size increases, ROC curves become less bowed and approach the diagonal, indicating reduced sensitivity.}}{5}{figure.6}\protected@file@percent }
\newlabel{fig:empirical_roc}{{6}{5}{Empirical ROC curves for each set size. Each point represents a different confidence threshold. As set size increases, ROC curves become less bowed and approach the diagonal, indicating reduced sensitivity}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Modeled ROC curves generated using equal-variance SDT formulation for each set size. Larger $d'$ values produce more bowed curves (greater discriminability), while smaller $d'$ values produce flatter curves closer to chance.}}{6}{figure.7}\protected@file@percent }
\newlabel{fig:modeled_roc}{{7}{6}{Modeled ROC curves generated using equal-variance SDT formulation for each set size. Larger $d'$ values produce more bowed curves (greater discriminability), while smaller $d'$ values produce flatter curves closer to chance}{figure.7}{}}
